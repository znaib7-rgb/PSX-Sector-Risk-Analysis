-- ============================================
-- Data inspection queries (per proposal Section 4.5,
-- "row counts, missing dates, duplicates, date range, sector label consistency")
-- ============================================

-- Row count and date range
SELECT COUNT(*) AS total_rows, MIN(date) AS earliest_date, MAX(date) AS latest_date
FROM sector_prices;

-- Row count and date range per ticker (spot missing history / delistings)
SELECT ticker, sector, COUNT(*) AS trading_days, MIN(date) AS first_date, MAX(date) AS last_date
FROM sector_prices
GROUP BY ticker, sector
ORDER BY sector, ticker;

-- Sector label consistency (should be exactly 6 sectors)
SELECT DISTINCT sector FROM sector_prices ORDER BY sector;

-- Duplicate ticker/date check (should return 0 rows if the UNIQUE constraint held on load)
SELECT ticker, date, COUNT(*)
FROM sector_prices
GROUP BY ticker, date
HAVING COUNT(*) > 1;

-- Null/zero price check
SELECT ticker, date
FROM sector_prices
WHERE open IS NULL OR high IS NULL OR low IS NULL OR close IS NULL
   OR open = 0 OR close = 0;
