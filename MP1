-- ============================================================
-- Schema: MP1 — Risk-Return Profile by Sector
-- Risk-Aware Sector Investing on PSX — AuratTech Fellowship
--
-- Scope: per the project proposal (Section 4.4), MP1 covers
-- foundational SQL (filtering, aggregation, calculated metrics)
-- on price data only. policy_events is introduced in MP2, when
-- prices are JOINed to policy-event dates.
-- ============================================================

-- ============================================
-- Table: sector_prices
-- One row per ticker per trading day
-- ============================================
CREATE TABLE sector_prices (
    id          SERIAL PRIMARY KEY,
    date        DATE NOT NULL,
    ticker      VARCHAR(10) NOT NULL,
    sector      VARCHAR(50) NOT NULL,
    open        NUMERIC(10,2),
    high        NUMERIC(10,2),
    low         NUMERIC(10,2),
    close       NUMERIC(10,2),
    volume      BIGINT,
    is_anomaly  BOOLEAN DEFAULT FALSE,

    CONSTRAINT uq_ticker_date UNIQUE (ticker, date)
);

CREATE INDEX idx_sector_prices_date   ON sector_prices (date);
CREATE INDEX idx_sector_prices_ticker ON sector_prices (ticker);
CREATE INDEX idx_sector_prices_sector ON sector_prices (sector);

