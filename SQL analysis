-- ============================================================
-- MP1: Sector Return & Risk Analysis
-- AuratTech Data & AI Fellowship — PSX Capstone
--
-- Prerequisite tables: sector_prices, policy_events
-- (see schema_create.sql / MP0 setup)
-- ============================================================

-- ============================================
-- Q1: Daily returns per ticker
-- (uses LAG to get previous day's close within each ticker)
-- ============================================
CREATE VIEW daily_returns AS
SELECT
    date,
    ticker,
    sector,
    close,
    LAG(close) OVER (PARTITION BY ticker ORDER BY date) AS prev_close,
    (close - LAG(close) OVER (PARTITION BY ticker ORDER BY date))
        / LAG(close) OVER (PARTITION BY ticker ORDER BY date) AS daily_return
FROM sector_prices
WHERE is_anomaly = FALSE;


-- ============================================
-- Q2: Average daily return per ticker
-- ============================================
SELECT
    ticker,
    sector,
    ROUND(AVG(daily_return)::numeric, 6) AS avg_daily_return,
    COUNT(*) AS trading_days
FROM daily_returns
WHERE daily_return IS NOT NULL
GROUP BY ticker, sector
ORDER BY sector, avg_daily_return DESC;


-- ============================================
-- Q3: Standard deviation (risk) per ticker
-- ============================================
SELECT
    ticker,
    sector,
    ROUND(STDDEV(daily_return)::numeric, 6) AS return_stddev
FROM daily_returns
WHERE daily_return IS NOT NULL
GROUP BY ticker, sector
ORDER BY sector, return_stddev;


-- ============================================
-- Q4: Average daily return per sector
-- (average across all tickers/days within the sector)
-- ============================================
SELECT
    sector,
    ROUND(AVG(daily_return)::numeric, 6) AS avg_daily_return,
    COUNT(*) AS observations
FROM daily_returns
WHERE daily_return IS NOT NULL
GROUP BY sector
ORDER BY avg_daily_return DESC;


-- ============================================
-- Q5: Standard deviation (risk) per sector
-- ============================================
SELECT
    sector,
    ROUND(STDDEV(daily_return)::numeric, 6) AS return_stddev
FROM daily_returns
WHERE daily_return IS NOT NULL
GROUP BY sector
ORDER BY return_stddev;


-- ============================================
-- Q6: Annualized return and volatility per sector
-- (252 trading days/year — standard convention)
-- ============================================
SELECT
    sector,
    ROUND((AVG(daily_return) * 252)::numeric, 4) AS annualized_return,
    ROUND((STDDEV(daily_return) * SQRT(252))::numeric, 4) AS annualized_volatility
FROM daily_returns
WHERE daily_return IS NOT NULL
GROUP BY sector
ORDER BY annualized_return DESC;


-- ============================================
-- Q7: Rank sectors by return (highest first)
-- ============================================
SELECT
    sector,
    ROUND(AVG(daily_return)::numeric, 6) AS avg_daily_return,
    RANK() OVER (ORDER BY AVG(daily_return) DESC) AS return_rank
FROM daily_returns
WHERE daily_return IS NOT NULL
GROUP BY sector;


-- ============================================
-- Q8: Rank sectors by risk (lowest stddev = rank 1 = safest)
-- ============================================
SELECT
    sector,
    ROUND(STDDEV(daily_return)::numeric, 6) AS return_stddev,
    RANK() OVER (ORDER BY STDDEV(daily_return) ASC) AS risk_rank
FROM daily_returns
WHERE daily_return IS NOT NULL
GROUP BY sector;


-- ============================================
-- Q9: Combined return + risk ranking in one table
-- (join Q7 and Q8 logic together for a single summary)
-- ============================================
WITH sector_stats AS (
    SELECT
        sector,
        ROUND(AVG(daily_return)::numeric, 6) AS avg_daily_return,
        ROUND(STDDEV(daily_return)::numeric, 6) AS return_stddev
    FROM daily_returns
    WHERE daily_return IS NOT NULL
    GROUP BY sector
)
SELECT
    sector,
    avg_daily_return,
    return_stddev,
    RANK() OVER (ORDER BY avg_daily_return DESC) AS return_rank,
    RANK() OVER (ORDER BY return_stddev ASC) AS risk_rank
FROM sector_stats
ORDER BY return_rank;


-- ============================================
-- Q10: Risk-adjusted return per sector (Sharpe-style, rf=0)
-- return per unit of risk — higher is better
-- ============================================
WITH sector_stats AS (
    SELECT
        sector,
        AVG(daily_return) AS avg_daily_return,
        STDDEV(daily_return) AS return_stddev
    FROM daily_returns
    WHERE daily_return IS NOT NULL
    GROUP BY sector
)
SELECT
    sector,
    ROUND(avg_daily_return::numeric, 6) AS avg_daily_return,
    ROUND(return_stddev::numeric, 6) AS return_stddev,
    ROUND((avg_daily_return / NULLIF(return_stddev, 0))::numeric, 4) AS return_per_unit_risk,
    RANK() OVER (ORDER BY (avg_daily_return / NULLIF(return_stddev, 0)) DESC) AS risk_adjusted_rank
FROM sector_stats
ORDER BY risk_adjusted_rank;
